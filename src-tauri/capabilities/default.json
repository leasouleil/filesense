{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
  "core:default",
  {
    "identifier": "shell:allow-spawn",
    "allow": [
      {
        "name": "binaries/filesense-backend",
        "sidecar": true,
        "args": true
      }
    ]
  },
  {
    "identifier": "shell:allow-kill"
  }
]
}
